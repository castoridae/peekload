{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!pnpm-lock.yaml", "!public/_locales"] },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useAriaPropsForRole": "off",
        "useSemanticElements": "off"
      },
      "style": { "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "overrides": [{ "includes": ["**/*.svg"], "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } } }],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
