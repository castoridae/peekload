{
  "name": "peekload",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Chrome extension (MV3) that opens exports from chosen sites in a preview instead of saving them to disk.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . && tsc -p test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "serve": "node test/server.ts",
    "zip": "pnpm build && node scripts/zip.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/chrome": "^0.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
